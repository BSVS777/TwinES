# SQLite database file used by the application.
DATABASE_URL="file:./dev.db"
# Passwords of the demo accounts created by the seed: 8 characters or more, at most 72 bytes.
SEED_TECH_PASSWORD=""
SEED_OWNER_PASSWORD=""
# Optional fixed calendar day (YYYY-MM-DD) for deterministic runs; ignored in production.
TWINES_FIXED_TODAY=""
# Optional: public origin of the app behind a TLS-terminating proxy (CSRF check).
# Defaults to the request origin when unset.
APP_ORIGIN="http://localhost:3000"